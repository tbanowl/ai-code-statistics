{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Frontend",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend",
            "command": "pnpm run serve"
        },
        {
            "name": "Python Debugger: Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload",
                "--port=8888"
            ],
            "jinja": true
        },
        {
            "name": "Debug git-ai",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin",
                    "git-ai"
                ],
                "filter": {
                    "name": "git-ai",
                    "kind": "bin"
                }
            },
            "args": [
                "status"
            ],
            "cwd": "${workspaceFolder}/git-ai",
            "env": {
                "RUST_BACKTRACE": "1",
                "GIT_AI_DEBUG": "1"
            }
        },
        {
            "name": "Debug git proxy handler",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin",
                    "git-ai"
                ],
                "filter": {
                    "name": "git-ai",
                    "kind": "bin"
                }
            },
            "args": [
                "status"
            ],
            "cwd": "${workspaceFolder}/git-ai",
            "env": {
                "RUST_BACKTRACE": "1",
                "GIT_AI_DEBUG": "1",
                "GIT_AI": "git"
            }
        },
        {
            "name": "Debug integration test",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package",
                    "git-ai",
                    "--test",
                    "simple_additions",
                    "--no-run"
                ],
                "filter": {
                    "name": "simple_additions",
                    "kind": "test"
                }
            },
            "args": [
                "--nocapture"
            ],
            "cwd": "${workspaceFolder}/git-ai",
            "env": {
                "RUST_BACKTRACE": "1",
                "GIT_AI_DEBUG": "1"
            }
        }
    ]
}